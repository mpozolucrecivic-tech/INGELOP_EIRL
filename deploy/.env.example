# ==========================================================================
# Configuración de PRODUCCIÓN. Copiar a deploy/.env y completar.
# ¡No subir deploy/.env a GitHub! (ya está en .gitignore)
# ==========================================================================

# ---- Dominios (sus registros DNS tipo A deben apuntar a la IP del VPS) ----
DOMINIO_WEB=ingelop.pe
DOMINIO_INTRANET=intranet.ingelop.pe
# Correo para avisos de Let's Encrypt (certificados HTTPS)
EMAIL_ACME=tu-correo@ejemplo.com

# ---- Secretos: generar valores largos y aleatorios ----
# Generar con:  openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto
# Generar con:  openssl rand -hex 48
JWT_SECRET=cambia-esto-por-una-clave-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=50

# ---- Formulario de contacto de la web ----
# Correo que recibe los mensajes (si se deja vacío usa el de web/includes/config.php)
CONTACTO_EMAIL=
# SMTP para enviar los correos (el del correo corporativo del hosting, o Gmail con "contraseña de aplicación").
# Si se deja vacío, los mensajes solo se guardan en el servidor (ver guía).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

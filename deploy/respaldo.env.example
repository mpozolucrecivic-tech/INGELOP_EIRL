# Configuración de deploy\respaldo.ps1. Copia este archivo a deploy\respaldo.env (NO se sube a Git).

# ---- Base de datos ----
# Neon: la cadena de conexión del panel de Neon (con ?sslmode=require).
# PostgreSQL de tu PC (Docker): usa host.docker.internal en lugar de localhost, por ejemplo:
#   postgresql://ingelop:dev123@host.docker.internal:5432/ingelop
DATABASE_URL=

# Imagen de PostgreSQL para pg_dump: su versión debe ser IGUAL O MAYOR que la del servidor (Neon muestra la versión).
RESPALDO_IMAGEN_PG=postgres:17-alpine

# ---- Archivos (elige una opción) ----
# a) Cloudflare R2 (los mismos datos que usa la API)
S3_PROVEEDOR=Cloudflare
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
# b) Carpeta local (si los archivos están en disco, por ejemplo backend\uploads)
# CARPETA_ARCHIVOS=C:\ruta\a\Ingelop_EIRL\backend\uploads

# ---- Copias ----
# Carpeta donde se guardan los .zip (por defecto, backups\ en el proyecto)
# RESPALDO_DESTINO=D:\Respaldos\INGELOP
RESPALDO_CONSERVAR=14

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://ingelop:dev123@localhost:5432/ingelop"

# JWT
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=4000
NODE_ENV=development

# CORS: orígenes permitidos separados por coma (sin "/" al final).
# Local: intranet (Vite) y web PHP (Docker).
# Producción, ejemplo: "https://ingelop.wuaze.com,https://intranet-ingelop.onrender.com"
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# Proxies de confianza delante de la API (0 en local; 1 en Render o detrás de Caddy).
# Necesario para que el límite de peticiones use la IP real del visitante.
TRUST_PROXY=0

# Límite de peticiones por IP (anti-spam y fuerza bruta)
RATE_LIMIT_VENTANA_MIN=15
RATE_LIMIT_CONTACTO=5
RATE_LIMIT_LOGIN=10

# Bloqueo por cuenta: tras N intentos fallidos seguidos, ese correo queda bloqueado M minutos
LOGIN_BLOQUEO_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# Auditoría: días que se conservan los registros (mínimo 730 = 2 años, Ley 29733)
AUDITORIA_RETENCION_DIAS=730

# Archivos
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=50
# Fotos de servicios de la web (jpg, png, webp)
MAX_FOTO_MB=5

# Dirección pública de la web PHP: enlaces de vista previa, canonical y sitemap.
CMS_WEB_URL="http://localhost:8080"

# Seed: credenciales del admin por defecto
SEED_ADMIN_EMAIL="admin@ingelop.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave"
SEED_USUARIO_PASSWORD="cambia-esta-otra-clave"

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://ingelop:dev123@localhost:5432/ingelop"

# JWT
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=4000
NODE_ENV=development

# CORS: orígenes permitidos separados por coma (frontend Vite por defecto)
CORS_ORIGIN="http://localhost:5173"

# Archivos
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=50

# Seed: credenciales del admin por defecto
SEED_ADMIN_EMAIL="admin@ingelop.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave"

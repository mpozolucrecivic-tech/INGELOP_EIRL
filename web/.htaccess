# ---- INGELOP – configuración Apache (hosting compartido) ----
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Página 404 propia
ErrorDocument 404 /404.php

# robots.txt se genera con PHP para incluir la URL completa del sitemap
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Bloquea archivos internos, respaldos y paquetes que nunca deben publicarse
RedirectMatch 404 ^/(includes|storage)(/|$)
RedirectMatch 404 (?i)\.(zip|tar|gz|7z|rar|sql|dump|bak)$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caché de recursos estáticos (los CSS/JS llevan ?v= para forzar la actualización)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

# URL base de la API. En desarrollo se usa el proxy de Vite (/api -> http://localhost:4000)
# Con el backend en Render, por ejemplo: VITE_API_URL=https://<servicio>.onrender.com/api/v1
# (se fija al compilar: después de cambiarla hay que volver a ejecutar npm run build)
VITE_API_URL=/api/v1

# Dirección pública de la web (enlace a la política de privacidad en el login). Ej.: https://ingelop.wuaze.com
VITE_WEB_URL=http://localhost:8080
